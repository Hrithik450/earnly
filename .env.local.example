# Supabase → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The publishable / anon key. Safe to expose to the browser: it is gated by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase → Project Settings → Database → Connection string.
# Used by Drizzle for every query. Connects as the table owner and therefore
# BYPASSES row-level security, so it must only ever be used in server code.
# Remember to URL-encode any special characters in the password.
#
# Use port 6543 (transaction pooler). Free-tier projects often refuse
# connections on 5432 (the session pooler), which shows up as an ECONNRESET or
# a connection timeout rather than an error that names the port.
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Public origin, used to build the email-verification redirect.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brevo → SMTP & API → API Keys. Sends our own transactional mail (currently the
# maintenance notice) over Brevo's HTTP API.
#
# Must be an API v3 key (xkeysib-…), NOT the SMTP key (xsmtpsib-…) configured
# inside Supabase. The two are not interchangeable — api.brevo.com rejects the
# SMTP one with "Key not found", which reads like a typo rather than a wrong
# credential.
#
# Supabase's own SMTP settings send auth mail only; Supabase owns those
# templates and offers no way to push anything else through them. Both paths
# leave through the same Brevo account.
#
# Brevo also enforces an IP allowlist per key by default, so a valid key still
# 401s from an unrecognised address (app.brevo.com/security/authorised_ips).
# Serverless hosts have no stable outbound IP, so on deploy this either needs a
# static-egress setup or the restriction turned off — in which case the key is
# the only credential, and it must stay a server-side variable.
#
# Unset is a supported state: sends are skipped with a console warning rather
# than failing the action, so local development needs no key.
BREVO_API_KEY=

# Must be a verified sender in Brevo, or every send is rejected.
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Earnly